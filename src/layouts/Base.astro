---
import "@fontsource-variable/inter";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import Header from "../components/Header.astro";
import { dict, localePath, locales, stripLocale, type Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  page?: "home" | "article";
  locale?: Locale;
  /** a blog post: marks the page as an article and describes it to search engines */
  post?: { title: string; description: string; published: Date; lang: Locale; image: string };
}

const { title, description, page = "article", locale = "en", post } = Astro.props;
const site = Astro.site!;
// one address per page: no trailing slash, same as the sitemap
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(path, site);
const here = stripLocale(path);
const ogImage = new URL(post?.image ?? "/og.png", site);

// Structured data: who this site is about, so search engines can tie it to the same person on X, GitHub and LinkedIn.
const person = {
  "@type": "Person",
  "@id": `${site.origin}/#kai`,
  name: "Kai Takami",
  url: site.origin + "/",
  jobTitle: "CTO",
  worksFor: { "@type": "Organization", name: "Domu", url: "https://domu.ai" },
  sameAs: ["https://x.com/kaitakami", "https://github.com/kaitakami", "https://linkedin.com/in/kaitakami"],
  knowsAbout: ["Distributed systems", "PostgreSQL", "Voice AI", "Software engineering"],
};
const graph: object[] = [
  person,
  {
    "@type": "WebSite",
    "@id": `${site.origin}/#site`,
    url: site.origin + "/",
    name: "Kai Takami",
    inLanguage: ["en", "es", "pt", "ja", "ko"],
    publisher: { "@id": person["@id"] },
  },
];
if (page === "home") graph.push({ "@type": "ProfilePage", url: canonical.href, mainEntity: { "@id": person["@id"] }, inLanguage: locale });
if (post)
  graph.push({
    "@type": "BlogPosting",
    headline: post.title,
    description: post.description,
    datePublished: post.published.toISOString(),
    inLanguage: post.lang,
    url: canonical.href,
    mainEntityOfPage: canonical.href,
    image: ogImage.href,
    author: { "@id": person["@id"] },
    publisher: { "@id": person["@id"] },
  });
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0e" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="author" content="Kai Takami" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, here), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(here, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Kai Takami" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Kai Takami · Notes" href="/notes.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Kai Takami" />
    <meta property="og:type" content={post ? "article" : page === "home" ? "profile" : "website"} />
    {post && <meta property="article:published_time" content={post.published.toISOString()} />}
    {post && <meta property="article:author" content={site.origin + "/"} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={post ? `${post.title}, by Kai Takami` : "Kai Takami: a dithered dusk over the Seto Inland Sea, with a road bike on the sea wall"} />
    <meta property="og:locale" content={dict[locale].intl.replace("-", "_")} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@kaitakami" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class={page}>
    <Header locale={locale} />
    <slot name="hero" />
    <main class="col">
      <slot />
    </main>
  </body>
</html>
