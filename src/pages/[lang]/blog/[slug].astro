---
import Post from "../../../views/Post.astro";
import { postsFor } from "../../../lib/posts";
import { defaultLocale, locales, type Locale } from "../../../i18n";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales.filter((l) => l !== defaultLocale)) {
    for (const post of await postsFor(lang)) paths.push({ params: { lang, slug: post.id }, props: { post } });
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
---

<Post post={Astro.props.post} locale={lang} />
